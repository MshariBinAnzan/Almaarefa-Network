# =============================================================================
# ALMAAREFA NETWORK — BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to .env and adjust values as needed.
# =============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:5000

# CORS Configuration (Comma-separated allowed origins for Frontend)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Database Configuration
# Option A: External PostgreSQL / Supabase connection string
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/almaarefa_network
# Option B: Embedded PostgreSQL (PGlite) for zero-setup local development
# Leave DATABASE_URL empty or set DB_MODE=pglite to use persistent embedded PostgreSQL
DB_MODE=auto
DATABASE_URL=
PGLITE_DATA_DIR=./database/.pgdata
AUTO_MIGRATE=true
AUTO_SEED=true

# University Domain Restriction
ALLOWED_EMAIL_DOMAINS=mcst.edu.sa

# JWT Authentication Secrets & Expiry
JWT_ACCESS_SECRET=almaarefa_dev_access_secret_change_in_production_2026
JWT_REFRESH_SECRET=almaarefa_dev_refresh_secret_change_in_production_2026
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=30

# File Storage & Uploads
UPLOAD_STORAGE_DIR=./uploads
UPLOAD_MAX_SIZE_BYTES=26214400
UPLOAD_PRESIGNED_EXPIRES_SECONDS=900

